HOST="0.0.0.0"
PORT="4000"
FRONTEND_URL="http://example.com"
BACKEND_URL="http://backend.example.com"

JWT_SECRET="secret" # 64 bit
JWT_EXPIRES_IN=1800

COOKIE_SECURE=true
COOKIES_SECRET="secret" # 64 bit
COOKIE_DOMAIN="backend.example.com"
COOKIE_EXPIRES_IN=2592000

REDIS_URL="redis://localhost:6379"

STORAGE_TEXTURES_TYPE="local" # local or s3
AWS_REGION=""
AWS_ENDPOINT_URL="https://s3.example.com"
AWS_ACCESS_KEY_ID="login"
AWS_SECRET_ACCESS_KEY="password"
BUCKET_NAME="textures"
AWS_PUBLIC_URL=""

DATABASE_URL="postgresql://username:password@host:port/database"
MAX_CONNECTION="30"
CONNECT_TIMEOUT="10" # second

EMAIL_FROM="no-replay@example.ru"
SMTP="smtps://username:password@host:port"
