HOST="0.0.0.0"
PORT="4000"
BACKEND_URL="http://backend.example.com"
FRONTEND_URL="http://example.com"

JWT_SECRET="secret" # u8 = 64bit !!!
JWT_EXPIRES_IN=1800 # seconds

COOKIE_SECURE=true
COOKIES_SECRET="secret" # u8 = 64bit !!!
COOKIE_EXPIRES_IN=2592000 # seconds

DATABASE_URL="mysql://username:password@host/database"

EMAIL_FROM="no-replay@example.ru"
SMTP="smtps://username:password@host" # https://docs.rs/lettre/latest/lettre/transport/smtp/struct.SmtpTransport.html#method.from_url
